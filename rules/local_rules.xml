<group name="local,custom,">

  <rule id="100001" level="10">
    <if_sid>60204</if_sid>
    <description>Custom: Multiple failed Windows logins (brute force)</description>
    <mitre><id>T1110</id></mitre>
  </rule>

  <rule id="100002" level="8">
    <if_sid>60109</if_sid>
    <description>Custom: New local user account created</description>
    <mitre><id>T1136.001</id></mitre>
  </rule>

  <rule id="100003" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)-enc</field>
    <description>Custom: Encoded PowerShell command</description>
    <mitre><id>T1059.001</id></mitre>
  </rule>

  <rule id="100004" level="10">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4732$</field>
    <description>Custom: User added to a local group</description>
    <mitre><id>T1098</id></mitre>
  </rule>

</group>
